{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/", "destination": "/admin.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/login/", "destination": "/login.html" },
    { "source": "/inventory", "destination": "/inventory.html" },
    { "source": "/inventory/", "destination": "/inventory.html" },
    { "source": "/order", "destination": "/order.html" },
    { "source": "/order/", "destination": "/order.html" },
    { "source": "/orders", "destination": "/order.html" },
    { "source": "/orders/", "destination": "/order.html" },
    { "source": "/api/create-order", "destination": "/api/pathao" },
    { "source": "/api/pathao-webhook", "destination": "/api/pathao?action=webhook" },
    { "source": "/api/status", "destination": "/api/inventory?status=true" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/api/inventory",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=86400"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=86400, stale-while-revalidate=86400"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, s-maxage=86400, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}