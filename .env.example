# ==============================================================================
# Rawgadz Platform - Environment Configuration Template
# ==============================================================================
# Duplicate this file as '.env' in final_public/ or project root.
# Notice: Storefront uses Sections 1 & 2; Admin Panel uses Sections 3 & 4.

# ------------------------------------------------------------------------------
# 1. Database Connection (MongoDB Atlas)
# ------------------------------------------------------------------------------
# Primary MongoDB connection URI (Collections: inventory, orders)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. Main Storefront Public Site Configuration (Extra for Storefront)
# ------------------------------------------------------------------------------
# Application Base URL (for redirects and callbacks)
APP_URL=http://localhost:3000

# Storefront Discount Coupon System
COUPON_CODE=RAWGADZ10
COUPON_DISCOUNT_PERCENT=10

# ------------------------------------------------------------------------------
# 3. Admin Panel - Pathao Courier Aladdin API Configuration
# ------------------------------------------------------------------------------
# Base API URL:
# - Production Hermes: https://api-hermes.pathao.com
# - Sandbox Testing: https://courier-api-sandbox.pathao.com
PATHAO_BASE_URL=https://api-hermes.pathao.com

# OAuth Client Credentials (from Pathao Merchant Portal)
PATHAO_CLIENT_ID=your_pathao_client_id
PATHAO_CLIENT_SECRET=your_pathao_client_secret

# Merchant Account Login Credentials
PATHAO_USERNAME=your_registered_pathao_email@example.com
PATHAO_PASSWORD=your_pathao_account_password

# Default Pickup Store ID (obtainable via GET /api/pathao?action=stores)
PATHAO_STORE_ID=189987

# ------------------------------------------------------------------------------
# 4. Admin Panel - Authentication & Security (Admin Panel Variables)
# ------------------------------------------------------------------------------
# Admin user credentials for logging into the Admin CMS
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password
AUTH_SECRET=your_jwt_signing_secret_key_change_in_production
ADMIN_NAME=Rawgad Admin